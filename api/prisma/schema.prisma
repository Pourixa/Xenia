// This is your Prisma schema file.
// Learn more in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id       Int    @id @default(autoincrement())
  username String @unique
  avatarUrl String?
  name String
  about String?
  githubAccountID BigInt @unique

  followings followship[] @relation("following")
  followers  followship[] @relation("follower")

  posts    post[]
  likes    like[]
  comments comment[]
}

model followship {
  id Int @id @default(autoincrement())

  followerId  Int 
  followingId Int
  notificationId Int
  
  createdAt DateTime @default(now())

  follower  user @relation("following", fields: [followerId], references: [id] , onDelete: Cascade) 
  following user @relation("follower", fields: [followingId], references: [id] , onDelete: Cascade)

  @@unique([followerId, followingId])
}

model post {
  id Int @id @default(autoincrement())

  authorId Int
  content  String

  createdAt DateTime @default(now())

  author   user      @relation(fields: [authorId], references: [id] , onDelete: Cascade)
  likes    like[]
  comments comment[]
}

model like {
  id Int @id @default(autoincrement())

  likerId Int
  postId  Int
  notificationId Int

  createdAt DateTime @default(now())

  liker user @relation(fields: [likerId], references: [id] , onDelete: Cascade)
  post  post @relation(fields: [postId], references: [id]  , onDelete: Cascade)

  @@unique([likerId, postId])
}

model comment {
  id Int @id @default(autoincrement())

  commenterId Int
  postId      Int
  content     String
  notificationId Int

  createdAt DateTime @default(now())

  commenter user @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  post      post @relation(fields: [postId], references: [id] , onDelete: Cascade)
}

enum EventTypes {
  FOLLOW
  LIKE
  COMMENT
}
